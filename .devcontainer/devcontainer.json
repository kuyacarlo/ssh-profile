{
  "name": "git-ssh",
  "image": "mcr.microsoft.com/devcontainers/go:1.24",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "go mod download"
}
